# Porta em que o servidor Express vai rodar
PORTA=3000

# String de conexão com o PostgreSQL
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
URL_BANCO_DE_DADOS=postgres://postgres:senha@localhost:5432/goapp

# Segredo usado para assinar os tokens JWT (troque por um valor forte em produção)
JWT_SEGREDO=troque_este_segredo_por_algo_bem_grande_e_aleatorio

# Tempo de expiração do token de acesso
JWT_EXPIRA_EM=7d

# Origem(ns) permitidas no CORS (separadas por vírgula). Use * em desenvolvimento.
ORIGENS_PERMITIDAS=*

# Segredo usado nas rotas administrativas simples (aprovar/reprovar motorista).
# Mande no header x-admin-secret. Troque por um valor forte antes de publicar.
SEGREDO_ADMIN=troque_por_uma_senha_forte
