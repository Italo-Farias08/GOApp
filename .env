# Porta em que o servidor Express vai rodar
PORTA=3000

# String de conexão com o PostgreSQL
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
URL_BANCO_DE_DADOS=postgres://postgres:senha@localhost:5432/goapp

# Segredo usado para assinar os tokens JWT (troque por um valor forte em produção)
JWT_SEGREDO=troque_este_segredo_por_algo_bem_grande_e_aleatorio

# Tempo de expiração do token de acesso
JWT_EXPIRA_EM=7d

# Origem(ns) permitidas no CORS (separadas por vírgula). Use * em desenvolvimento.
ORIGENS_PERMITIDAS=*

# Segredo usado nas rotas administrativas simples (aprovar/reprovar motorista).
# Mande no header x-admin-secret. Troque por um valor forte antes de publicar.
SEGREDO_ADMIN=troque_por_uma_senha_forte

# Access Token do Mercado Pago (o token de SERVIDOR, não a Public Key).
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
# Use um token TEST-... pra testar sem mexer com dinheiro de verdade, e troque
# pro APP_USR-... só quando for pra produção.
MERCADO_PAGO_ACCESS_TOKEN=TEST-troque_por_seu_access_token

# URL pública onde ESSE backend está rodando (a mesma da Railway, por
# exemplo) — usada só como referência ao configurar o webhook de notificação
# do Mercado Pago em https://.../payments/webhook
URL_PUBLICA_BACKEND=https://goapp-production-1057.up.railway.app

# Chave da API do Google Places, usada pra busca de endereço (autocomplete)
# e resolução de coordenadas. Pegue em:
# https://console.cloud.google.com/google/maps-apis/credentials
# Precisa ter "Places API" e "Geocoding API" habilitadas no projeto, com
# billing ativo (tem cota gratuita mensal, mas exige cartão cadastrado).
# Restrinja a chave por "IP addresses" apontando pro IP do Railway, já que
# ela fica só no backend e nunca vai pro app.
GOOGLE_PLACES_API_KEY=coloque_sua_chave_aqui
